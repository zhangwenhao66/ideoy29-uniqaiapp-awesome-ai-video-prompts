{
  "$comment": "Schema for every record in data/prompts/*.json. Validated by scripts/validate.py (hand-written validator, stdlib only; this file is the readable spec, not a JSON Schema draft).",
  "schema_version": 1,
  "record": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "unique": true, "required": true },
    "title": { "type": "string", "min": 4, "max": 80, "required": true },
    "use_case": { "type": "string", "enum": ["camera-moves", "product", "portrait", "nature", "action", "ads", "anime", "image-to-video", "stills"], "required": true },
    "mode": { "type": "string", "enum": ["t2v", "i2v", "t2i", "i2i"], "required": true,
              "$comment": "t2v text-to-video, i2v image-to-video, t2i text-to-image, i2i image edit" },
    "models": { "type": "array", "items": { "enum": ["kling-3", "veo-3", "wan-2.5", "runway-gen-4", "seedance-2", "flux", "nano-banana", "gpt-image"] }, "min_items": 1, "required": true,
                "$comment": "Models the prompt is written for. Not a claim that it was rendered there: see rendered_on." },
    "duration_s": { "type": "integer", "min": 2, "max": 30, "required_when": { "mode": ["t2v", "i2v"] } },
    "aspect": { "type": "string", "enum": ["16:9", "9:16", "1:1", "3:4", "4:3"], "required": true },
    "prompt": { "type": "string", "min": 20, "max": 1200, "required": true, "$comment": "The prompt, verbatim. No placeholders in angle brackets except in image-to-video entries that refer to 'the photo'." },
    "why": { "type": "string", "min": 40, "max": 700, "required": true, "$comment": "Why it works: structure, not adjectives." },
    "tags": { "type": "array", "items": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "min_items": 1, "max_items": 6, "required": true },
    "rendered_on": { "type": "array", "required": true, "items": {
        "model": { "enum": ["kling-3", "veo-3", "wan-2.5", "runway-gen-4", "seedance-2", "flux", "nano-banana", "gpt-image"], "required": true },
        "date": { "type": "date", "required": true },
        "result": { "type": "string", "min": 10, "max": 400, "required": true }
      }, "$comment": "Empty array means nobody has reported a render yet. An entry here is a claim; include what you saw, including what went wrong." },
    "source": { "type": "object", "fields": { "label": { "type": "string", "required": true }, "url": { "type": "url" }, "date": { "type": "date", "required": true } } },
    "guide": { "type": "object", "fields": { "label": { "type": "string", "required": true }, "url": { "type": "url", "required": true }, "date": { "type": "date", "required": true } },
               "$comment": "The vendor prompt guide the entry follows, with the date it was checked." },
    "added": { "type": "date", "required": true }
  }
}
